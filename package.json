{
  "name": "solostudio",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "Solo Studio: a practice room on the iPad for a young performer's first rap-and-dance solo.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && node scripts/voice.mjs --check && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "review": "UPDATE_REVIEW=1 vitest run tests/unit/review-md.test.ts",
    "privacy": "node scripts/privacy-scan.mjs",
    "voice": "node scripts/voice.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.10",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
