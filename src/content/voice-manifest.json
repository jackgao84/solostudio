    },
    {
      "text": "Opening pose",
      "file": "3dfdfd035a2774d0.mp3",
      "chars": 12,
      "bytes": 4406,
      "ms": 1071
    },
    {
      "text": "Ending pose. Hold it!",
      "file": "cb930c89b1bafff1.mp3",
      "chars": 21,
      "bytes": 6600,
      "ms": 1620
    },
    {
      "text": "Take a bow",
      "file": "e1db4b60e2578b38.mp3",
      "chars": 10,
      "bytes": 4197,
      "ms": 1019
    },
    {
      "text": "Walk off the stage",
      "file": "d247820705c98346.mp3",
      "chars": 18,
      "bytes": 5659,
      "ms": 1384
    },
    {
      "text": "Close your eyes. Imagine you are on stage, performing your song.",
      "file": "79a7a3c636995bad.mp3",
      "chars": 64,
      "bytes": 16108,
      "ms": 3997
    },
    {
      "text": "Open your eyes. That was your listening run.",
      "file": "dd1252ca49b9d9e7.mp3",
      "chars": 44,
      "bytes": 10884,
      "ms": 2691
    },
    {
      "text": "Tap Start today’s practice. The iPad takes you through every part.",
      "file": "e5773cecfaf4fdb5.mp3",
      "chars": 66,
      "bytes": 16317,
      "ms": 4049
    },
    {
      "text": "Before every go you hear 5, 6, 7, 8. That’s your time to get to your spot.",
      "file": "41f6049f11868137.mp3",
      "chars": 74,
      "bytes": 20915,
      "ms": 5198
    },
    {
      "text": "The music keeps looping. Tap I did it, Next or Pause from where you stand.",
      "file": "6eec3c17dbcec019.mp3",
      "chars": 74,
      "bytes": 20184,
      "ms": 5016
    },
    {
      "text": "Each step you tick switches on a light on your stage.",
      "file": "e15f4b973e1bd09f.mp3",
      "chars": 53,
      "bytes": 11615,
      "ms": 2873
    },
    {
      "text": "Showtime is the whole show: breathe, walk on, perform and bow.",
      "file": "6da6e714852dcbb3.mp3",
      "chars": 62,
      "bytes": 21855,
      "ms": 5433
    },
    {
      "text": "You’re ready. Have fun!",
